# Local API defaults. Keep the API bound to loopback until public access is designed.
CV_AUTOMATION_API_HOST=127.0.0.1
CV_AUTOMATION_API_PORT=8000
CV_AUTOMATION_APP_ENV=development
CV_AUTOMATION_LOG_LEVEL=INFO
# Generate a random token with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# CV_AUTOMATION_API_TOKEN=

# TiDB settings are intentionally blank. Configure only in a protected local .env
# after provisioning a least-privilege application account and obtaining the CA file.
# The application requires all five values together and always verifies TLS.
# CV_AUTOMATION_DB_HOST=
# CV_AUTOMATION_DB_PORT=4000
# CV_AUTOMATION_DB_USER=
# CV_AUTOMATION_DB_PASSWORD=
# CV_AUTOMATION_DB_NAME=
# CV_AUTOMATION_DB_CA_FILE=

# SMTP is disabled until a host and sender address are supplied. User/password
# can be omitted for a trusted relay; use STARTTLS or implicit TLS only.
# CV_AUTOMATION_SMTP_HOST=
# CV_AUTOMATION_SMTP_PORT=587
# CV_AUTOMATION_SMTP_USERNAME=
# CV_AUTOMATION_SMTP_PASSWORD=
# CV_AUTOMATION_SMTP_FROM_ADDRESS=
# CV_AUTOMATION_SMTP_FROM_NAME=
# CV_AUTOMATION_SMTP_SECURITY=starttls
# CV_AUTOMATION_SMTP_TIMEOUT_SECONDS=20

# Worker defaults: bounded batches, 3-minute leases, exponential SMTP retries.
# CV_AUTOMATION_WORKER_BATCH_SIZE=10
# CV_AUTOMATION_WORKER_POLL_INTERVAL_SECONDS=2
# CV_AUTOMATION_WORKER_LEASE_SECONDS=180
# CV_AUTOMATION_WORKER_MAX_ATTEMPTS=5
# CV_AUTOMATION_WORKER_RETRY_BASE_SECONDS=30
# CV_AUTOMATION_WORKER_RETRY_MAX_SECONDS=3600
